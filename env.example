# Database
DB_NAME=merkoteks_hr

# Admin - ilk kurulumda oluşturulacak örnek kullanıcı
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Yönetici

# JWT - her kurulumda yeni ve güçlü bir değer üretin
JWT_SECRET=CHANGE_ME_WITH_RANDOM_64_CHAR_SECRET

# E-posta
EMAIL_FROM_NAME=Personel ve İzin Yönetim Sistemi

# Cron secret
WEBHOOK_CRON_SECRET=CHANGE_ME

# CORS
CORS_ORIGINS=*

# Local storage
STORAGE_MODE=local
MONGO_URL=mongodb://mongodb:27017
UPLOAD_PATH=/data/uploads