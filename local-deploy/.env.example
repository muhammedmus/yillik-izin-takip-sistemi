# =============================================================================
# Merkoteks Personel & İzin — LOCAL/ON-PREMISE ENV
# =============================================================================
# Bu dosyayı kopyalayıp `.env` olarak kaydedin ve değerleri düzenleyin.
# ÖNEMLİ: Production secret'larını buraya YAZMAYIN — bu ortam local için.

# ---- Windows host data path -------------------------------------------------
# MongoDB verileri ve yüklenen belgeler bu klasörde kalıcı olarak tutulur.
# Windows'ta ters slash yerine düz slash kullanın veya çift ters slash:
#   D:/PersonelIzin/data     (önerilen)
#   D:\\PersonelIzin\\data   (alternatif)
DATA_DIR=D:/PersonelIzin/data

# ---- Database ---------------------------------------------------------------
DB_NAME=merkoteks_hr

# ---- Auth (İLK BAŞLATMA'da admin kullanıcısı seed edilir) -------------------
# Bu değerleri MUTLAKA değiştirin, güçlü şifre kullanın.
ADMIN_EMAIL=admin@merkoteks.local
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Yönetici

# ---- JWT (güçlü random, en az 64 karakter) ----------------------------------
# Aşağıdaki komut ile üretin:
#   Windows PowerShell: [Convert]::ToBase64String((1..64|%{Get-Random -Max 256}))
#   Linux/macOS:        openssl rand -base64 64
JWT_SECRET=BURAYA_64_KARAKTER_RASTGELE_DEGER_YAZIN_ORNEK_openssl_rand_base64_64

# ---- Görünen isim (e-posta gönderiminde) ------------------------------------
EMAIL_FROM_NAME=Merkoteks Personel Sistemi

# ---- Cron secret (local'de kullanılmıyor ama env boş olmasın) ---------------
WEBHOOK_CRON_SECRET=local-cron-not-used

# ---- CORS (local için wildcard yeterli — reverse proxy same-origin yapıyor) -
CORS_ORIGINS=*
